# ─────────────────────────────────────────────────────────────────────────────
# Fali's Ecommerce — Environment Variables
# Copy this file to .env.local and fill in values before running locally.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Full URL of this deployment (no trailing slash)
# Local: http://localhost:3000  |  Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — ONLY for server-side code. Never expose to the client.
# Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use TEST keys locally and in preview. LIVE keys only in production.
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# From: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── PostHog Analytics ─────────────────────────────────────────────────────────
# https://app.posthog.com/project/settings → Project API Key
NEXT_PUBLIC_POSTHOG_KEY=phc_...
# Use https://us.i.posthog.com (US) or https://eu.i.posthog.com (EU)
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Rate Limiting (optional, Upstash Redis) ───────────────────────────────────
# https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxx...

# ── Build Flags ───────────────────────────────────────────────────────────────
# Set to 'true' in CI when env vars are mocked/unavailable
# SKIP_ENV_VALIDATION=true
