# ─────────────────────────────────────────────────────────────────────────────
# Fali's Ecommerce — Environment Variables
# Copy this file to .env.local and fill in values before running locally.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
# Full URL of this deployment (no trailing slash)
# Local: http://localhost:3000  |  Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role key — ONLY for server-side code. Never expose to the client.
# Project Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Stripe ────────────────────────────────────────────────────────────────────
# Use TEST keys locally and in preview. LIVE keys only in production.
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# From: Stripe Dashboard → Developers → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Analytics & Monitoring ────────────────────────────────────────────────────
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
# https://analytics.google.com → Admin → Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Axiom structured logs — https://app.axiom.co/tokens
AXIOM_TOKEN=xaat-...
AXIOM_DATASET=ecomm-dev

# Sentry error tracking — https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=https://xxx@yyy.ingest.sentry.io/zzz
SENTRY_AUTH_TOKEN=sntrys_...
SENTRY_ORG=your-org
SENTRY_PROJECT=falis-perfume

# ── Rate Limiting (optional, Upstash Redis) ───────────────────────────────────
# https://console.upstash.com → Redis → REST API
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxx...

# ── Build Flags ───────────────────────────────────────────────────────────────
# Set to 'true' in CI when env vars are mocked/unavailable
# SKIP_ENV_VALIDATION=true
